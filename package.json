{
  "name": "tots-test-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:ng": "ng test",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.5.1",
  "overrides": {
    "systeminformation": "^5.27.14"
  },
  "dependencies": {
    "@angular/animations": "~19.1.0",
    "@angular/cdk": "~19.1.0",
    "@angular/common": "~19.1.0",
    "@angular/compiler": "~19.1.0",
    "@angular/core": "~19.1.0",
    "@angular/forms": "~19.1.0",
    "@angular/material": "~19.1.0",
    "@angular/platform-browser": "~19.1.0",
    "@angular/router": "~19.1.0",
    "@auth0/angular-jwt": "^5.2.0",
    "@mckit/core": "^19.0.0",
    "@mckit/filter": "^19.0.6",
    "@mckit/form": "^19.0.38",
    "@mckit/table": "^19.0.14",
    "@primeuix/themes": "^2.0.2",
    "date-fns": "^4.1.0",
    "ngx-toastr": "^19.1.0",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "~19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.1.0",
    "@angular/cli": "~19.1.0",
    "@angular/compiler-cli": "~19.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.0.3",
    "cypress": "^15.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.7.0",
    "vitest": "^4.0.8"
  }
}
